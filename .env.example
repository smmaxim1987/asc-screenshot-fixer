# Local server port
PORT=8787

# Host (defaults to 127.0.0.1 — reachable only from this machine)
HOST=127.0.0.1

# Allow network access (caution: credentials are entered through the web UI)
# HOST=0.0.0.0

# Base URL for App Store Connect API requests (defaults to api.appstoreconnect.apple.com)
ASC_API_BASE_URL=https://api.appstoreconnect.apple.com

# Whether to emit a request audit log
LOG_REQUESTS=true